@using AsyncHub.MicrosoftEntraPowerAdmin.WebUI.Graph
<MudCheckBox T="bool" Label="Include Basic Claim Set" @bind-Value="Draft.IncludeBasicClaimSet"
             @bind-Value:after="DraftChanged" Disabled="IsDisabled" />
<MudText Typo="Typo.h6" Class="mt-3">Claims Schema (@Draft.Claims.Count / 50)</MudText>
<MudText Typo="Typo.body2">Each claim needs at least one output type: JWT, SAML, or both. No transformations are supported.</MudText>
@foreach (var claim in Draft.Claims)
{
  <MudPaper @key="claim" Outlined="true" Class="pa-3 my-3">
    <MudSelect T="ClaimValueMode" Label="Claim value" @bind-Value="claim.Mode"
               @bind-Value:after="@(() => ModeChanged(claim))" Disabled="IsDisabled">
      <MudSelectItem Value="ClaimValueMode.DirectoryAttribute">Directory attribute</MudSelectItem>
      <MudSelectItem Value="ClaimValueMode.ConstantValue">Constant value</MudSelectItem>
    </MudSelect>
    @if (claim.Mode == ClaimValueMode.DirectoryAttribute)
    {
      <MudSelect T="string" Label="Source" @bind-Value="claim.Source"
                 @bind-Value:after="@(() => SourceChanged(claim))" Disabled="IsDisabled">
        @foreach (var source in ClaimsMappingClaimSources.Sources)
        {
          <MudSelectItem T="string" Value="@source">@ClaimsMappingClaimSources.Label(source)</MudSelectItem>
        }
      </MudSelect>
      <MudAutocomplete T="string" Label="Attribute ID" @bind-Value="claim.Id" @bind-Value:after="DraftChanged"
                       SearchFunc="@((text, token) => SearchPropertiesAsync(claim.Source, text, token))"
                       CoerceValue="true" CoerceText="false" Immediate="true" DebounceInterval="0" Disabled="IsDisabled"
                       HelperText="Choose a known property or enter an attribute ID supported by Microsoft Entra." />
    }
    else
    {
      <MudTextField T="string" Label="Value" @bind-Value="claim.Value" @bind-Value:after="DraftChanged"
                    Immediate="true" Disabled="IsDisabled" />
    }
    <MudTextField T="string" Label="JWT claim type" @bind-Value="claim.JwtClaimType" @bind-Value:after="DraftChanged"
                  Immediate="true" Disabled="IsDisabled" />
    <MudTextField T="string" Label="SAML claim type" @bind-Value="claim.SamlClaimType" @bind-Value:after="DraftChanged"
                  Immediate="true" Disabled="IsDisabled" />
    <MudButton OnClick="@(() => RemoveClaim(claim))" Disabled="IsDisabled" Color="Color.Error">Remove claim</MudButton>
  </MudPaper>
}
<MudButton OnClick="AddClaim" Disabled="@(IsDisabled || Draft.Claims.Count >= CreateClaimsMappingPolicyRequest.MaximumClaims)"
           Variant="Variant.Outlined" Class="my-3">Add claim</MudButton>

