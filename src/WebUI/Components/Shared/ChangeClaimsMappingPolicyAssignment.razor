@using AsyncHub.MicrosoftEntraPowerAdmin.WebUI.Graph

<MudPaper Outlined="true" Class="pa-4 my-4" role="dialog" aria-label="Claims Mapping Policy assignment confirmation">
  <MudText Typo="Typo.h6" HtmlTag="h2">@ActionLabel Claims Mapping Policy</MudText>
  <MudText Class="my-2">Tenant: @_tenantName (@Context.TenantId)</MudText>
  @if (_error is not null || _loading)
  {
    <DirectoryStatus Error="_error" IsLoading="_loading" />
  }
  @if (!_invalidated)
  {
    @if (IsUnassignment)
    {
      <MudAlert Severity="Severity.Info" Class="my-3">Unassignment removes only this relationship. It does not delete the policy, Service Principal, or App Registration.</MudAlert>
    }
    else
    {
      <MudAlert Severity="Severity.Info" Class="my-3">Assigning a Claims Mapping Policy changes the claims configuration used for this Enterprise Application. It takes precedence over Custom Claims Policy and claims configured through the Entra admin center, which may no longer control the issued token while this policy is assigned.</MudAlert>
    }
    @if (Principal is null && !IsUnassignment)
    {
      <MudTextField @bind-Value="_search" Label="Find Enterprise Application by name, Client ID, or Object ID" Disabled="IsBusy" />
      <MudButton OnClick="SearchAsync" Disabled="IsBusy">Search</MudButton>
      <MudTable Items="AvailablePrincipals" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent><MudTh>Enterprise Application</MudTh><MudTh>Application / Client ID</MudTh><MudTh>Service Principal Object ID</MudTh><MudTh>Select</MudTh></HeaderContent>
        <RowTemplate>
          <MudTd>@context.DisplayName</MudTd>
          <MudTd>@context.AppId</MudTd>
          <MudTd>@context.ObjectId</MudTd>
          <MudTd><MudButton OnClick="@(() => SelectPrincipalAsync(context))" Disabled="IsBusy">Select</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No available Enterprise Applications on this page. Search or check the next page.</MudText></NoRecordsContent>
      </MudTable>
      @if (_principalPage?.NextPage is not null)
      {
        <MudButton OnClick="NextPageAsync" Disabled="IsBusy">Next page</MudButton>
      }
    }
    @if (Policy is null && !IsUnassignment)
    {
      <MudTextField @bind-Value="_policyFilter" Immediate="true" Label="Filter policies by display name or Policy Object ID" Disabled="IsBusy" />
      <MudSelect T="ClaimsMappingPolicyListItem" @bind-Value="_policy" ToStringFunc="PolicyLabel" Label="Claims Mapping Policy" Disabled="IsBusy">
        @foreach (var item in FilteredPolicies)
        {
          <MudSelectItem Value="item">@item.DisplayName — Policy Object ID: <b>@item.ObjectId</b></MudSelectItem>
        }
      </MudSelect>
      @if (!_loading && _availablePolicies.Count == 0 && _error is null)
      {
        <MudText>No unassigned policies are available for this Service Principal.</MudText>
      }
    }
    @if (_policy is { } selectedPolicy)
    {
      <MudText Class="mt-3">Policy: @selectedPolicy.DisplayName</MudText>
      <MudText>Policy Object ID: @selectedPolicy.ObjectId</MudText>
    }
    @if (_principal is { } selectedPrincipal)
    {
      <MudText Class="mt-3">Enterprise Application: @selectedPrincipal.DisplayName</MudText>
      <MudText>Service Principal Object ID: @selectedPrincipal.ObjectId</MudText>
      <MudText>Application / Client ID: @selectedPrincipal.AppId</MudText>
      @if (!IsUnassignment && _assignedPolicies.Count > 0)
      {
        <MudText Class="mt-3">Existing assignments remain in place:</MudText>
        @foreach (var assigned in _assignedPolicies)
        {
          <MudText>@assigned.DisplayName — Policy Object ID: @assigned.ObjectId</MudText>
        }
      }
    }
  }
  <MudButton OnClick="OnCancel" Disabled="@(_mutating || _loading)" Class="mt-3">Cancel</MudButton>
  <MudButton OnClick="ConfirmAsync" Disabled="@(!CanConfirm)" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3">@ActionLabel</MudButton>
</MudPaper>
