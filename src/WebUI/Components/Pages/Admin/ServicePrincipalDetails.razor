@page "/service-principals/{ObjectId}"

<PageTitle>Enterprise Application - MEPA</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4 directory-value">@(_state.Value?.Details.ServicePrincipal.DisplayName ?? "Enterprise Application")</MudText>
<MudButton Href="/service-principals" Class="mb-3">Back to Enterprise Applications</MudButton>
<DirectoryStatus Error="DisplayError" IsLoading="_state.IsLoading" />
@if (!_state.IsLoading)
{
  <MudButton OnClick="LoadAsync" Class="mb-3">Refresh</MudButton>
}
@if (_state.Value is { } inspection)
{
  var details = inspection.Details;
  var item = details.ServicePrincipal;
  <MudPaper Outlined="true" Class="pa-4 mb-4 application-details">
    <section aria-labelledby="principal-general-heading">
      <MudText Typo="Typo.h6" HtmlTag="h2" id="principal-general-heading">General</MudText>
      <dl>
        <div class="application-detail-row">
          <dt>Application / Client ID</dt>
          <dd>
            @if (item.AppId.HasValue)
            {
              <CopyIdentifier Value="item.AppId" Label="Application / Client ID" />
            }
            else
            {
              <ApplicationDetailValue />
            }
          </dd>
        </div>
        <div class="application-detail-row">
          <dt>Service Principal Object ID</dt>
          <dd><CopyIdentifier Value="item.ObjectId" Label="Service Principal Object ID" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Description</dt>
          <dd><ApplicationDetailValue Value="@details.Description" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Service Principal Type</dt>
          <dd><ApplicationDetailValue Value="@item.ServicePrincipalType" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Account Enabled</dt>
          <dd><ApplicationDetailValue BooleanValue="item.AccountEnabled" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Verified Publisher Name</dt>
          <dd><ApplicationDetailValue Value="@item.PublisherName" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>App Owner Organization ID</dt>
          <dd>
            @if (details.AppOwnerOrganizationId.HasValue)
            {
              <CopyIdentifier Value="details.AppOwnerOrganizationId" Label="App Owner Organization ID" />
            }
            else
            {
              <ApplicationDetailValue />
            }
          </dd>
        </div>
      </dl>
    </section>
    <section aria-labelledby="principal-authentication-heading">
      <MudText Typo="Typo.h6" HtmlTag="h2" id="principal-authentication-heading">Authentication and Identifiers</MudText>
      <dl>
        <div class="application-detail-row">
          <dt>Homepage</dt>
          <dd><ApplicationDetailValue Value="@details.Homepage" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Login URL</dt>
          <dd><ApplicationDetailValue Value="@details.LoginUrl" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Service Principal Names</dt>
          <dd><ApplicationDetailValue Values="details.ServicePrincipalNames" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Tags</dt>
          <dd><ApplicationDetailValue Values="details.Tags" /></dd>
        </div>
      </dl>
    </section>
  </MudPaper>
  <AssignedClaimsMappingPolicies @key="item.ObjectId" ServicePrincipal="item" />
  <MudText Class="my-3">The Application / Client ID links these objects. Each object has its own tenant-specific Object ID.</MudText>
  <MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.h6" HtmlTag="h2">App Registration — same Client ID</MudText>
    @if (inspection.Related.IsSuccess)
    {
      @if (inspection.Related.Value.HasValue)
      {
        var linked = inspection.Related.Value.Value.Application;
        <MudText>@linked.DisplayName</MudText>
        <MudText Class="mt-2">Application / Client ID</MudText>
        <CopyIdentifier Value="linked.AppId" Label="Application / Client ID" />
        <MudText Class="mt-2">Application Object ID</MudText>
        <CopyIdentifier Value="linked.ObjectId" Label="Application Object ID" />
        <div><MudButton OnClick="OpenRelated" Color="Color.Primary" Class="mt-3">Open App Registration</MudButton></div>
      }
      else
      {
        <MudText>The App Registration is owned by another tenant or is not present in the current tenant.</MudText>
      }
    }
    else
    {
      <MudText>The related object could not be checked. Resolve the error above and refresh.</MudText>
    }
  </MudPaper>
}
