@page "/applications/{ObjectId}"

<PageTitle>App Registration - MEPA</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4 directory-value">@(_state.Value?.Details.Application.DisplayName ?? "App Registration")</MudText>
<MudButton Href="/applications" Class="mb-3">Back to App Registrations</MudButton>
<DirectoryStatus Error="DisplayError" IsLoading="_state.IsLoading" />
@if (!_state.IsLoading)
{
  <MudButton OnClick="LoadAsync" Class="mb-3">Refresh</MudButton>
}
@if (_state.Value is { } inspection)
{
  var details = inspection.Details;
  var item = details.Application;
  <MudPaper Outlined="true" Class="pa-4 mb-4 application-details">
    <section aria-labelledby="application-general-heading">
      <MudText Typo="Typo.h6" HtmlTag="h2" id="application-general-heading">General</MudText>
      <dl>
        <div class="application-detail-row">
          <dt>Application / Client ID</dt>
          <dd>
            @if (item.AppId.HasValue)
            {
              <CopyIdentifier Value="item.AppId" Label="Application / Client ID" />
            }
            else
            {
              <ApplicationDetailValue />
            }
          </dd>
        </div>
        <div class="application-detail-row">
          <dt>Application Object ID</dt>
          <dd><CopyIdentifier Value="item.ObjectId" Label="Application Object ID" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Description</dt>
          <dd><ApplicationDetailValue Value="@details.Description" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Sign-in Audience</dt>
          <dd><ApplicationDetailValue Value="@item.SignInAudience" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Created</dt>
          <dd><ApplicationDetailValue Value="@FormatCreated(item.CreatedDateTime)" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Publisher Domain</dt>
          <dd><ApplicationDetailValue Value="@item.PublisherDomain" IsTechnical="true" /></dd>
        </div>
      </dl>
    </section>
    <section aria-labelledby="application-api-heading">
      <MudText Typo="Typo.h6" HtmlTag="h2" id="application-api-heading">API</MudText>
      <dl>
        <div class="application-detail-row">
          <dt>Accept mapped claims</dt>
          <dd><ApplicationDetailValue BooleanValue="details.AcceptMappedClaims" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Requested access token version</dt>
          <dd><ApplicationDetailValue Value="@(details.RequestedAccessTokenVersion?.ToString())" /></dd>
        </div>
      </dl>
    </section>
    <section aria-labelledby="application-authentication-heading">
      <MudText Typo="Typo.h6" HtmlTag="h2" id="application-authentication-heading">Authentication and Identifiers</MudText>
      <dl>
        <div class="application-detail-row">
          <dt>Web redirect URIs</dt>
          <dd><ApplicationDetailValue Values="details.WebRedirectUris" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>SPA redirect URIs</dt>
          <dd><ApplicationDetailValue Values="details.SpaRedirectUris" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Public client redirect URIs</dt>
          <dd><ApplicationDetailValue Values="details.PublicClientRedirectUris" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Identifier URIs</dt>
          <dd><ApplicationDetailValue Values="details.IdentifierUris" IsTechnical="true" /></dd>
        </div>
        <div class="application-detail-row">
          <dt>Tags</dt>
          <dd><ApplicationDetailValue Values="details.Tags" /></dd>
        </div>
      </dl>
    </section>
  </MudPaper>
  <MudText Class="my-3">The Application / Client ID links these objects. Each object has its own tenant-specific Object ID.</MudText>
  <MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.h6" HtmlTag="h2">Enterprise Application — same Client ID</MudText>
    @if (inspection.Related.IsSuccess)
    {
      @if (inspection.Related.Value.HasValue)
      {
        var linked = inspection.Related.Value.Value.ServicePrincipal;
        <MudText>@linked.DisplayName</MudText>
        <MudText Class="mt-2">Application / Client ID</MudText>
        <CopyIdentifier Value="linked.AppId" Label="Application / Client ID" />
        <MudText Class="mt-2">Service Principal Object ID</MudText>
        <CopyIdentifier Value="linked.ObjectId" Label="Service Principal Object ID" />
        <div><MudButton OnClick="OpenRelated" Color="Color.Primary" Class="mt-3">Open Enterprise Application</MudButton></div>
      }
      else
      {
        <MudText>No Enterprise Application / Service Principal exists for this application in the current tenant.</MudText>
      }
    }
    else
    {
      <MudText>The related object could not be checked. Resolve the error above and refresh.</MudText>
    }
  </MudPaper>
}
