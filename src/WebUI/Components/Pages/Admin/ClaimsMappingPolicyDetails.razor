@page "/claims-mapping-policies/{ObjectId}"

<PageTitle>Claims Mapping Policy - MEPA</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Claims Mapping Policy</MudText>
<MudButton Href="/claims-mapping-policies" Class="mb-3">Back to Claims Mapping Policies</MudButton>
<DirectoryStatus Error="DisplayError" IsLoading="_state.IsLoading" />
@if (_operationError is not null)
{
  <DirectoryStatus Error="_operationError" />
}
@if (!_state.IsLoading)
{
  <MudButton OnClick="LoadAsync" Disabled="@(_confirmation is not null || _editContext is not null || _openingEditor)" Class="mb-3">Refresh</MudButton>
}
@if (_openingEditor)
{
  <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading latest policy for editing" />
}
@if (_editContext is { } editContext)
{
  <EditClaimsMappingPolicy @key="editContext" Context="editContext" OnCancel="Cancel" OnReload="EditAsync"
                          OnSaved="PolicySavedAsync" OnMissing="PolicyMissingAsync" />
}
@if (_editContext is null && _state.Value is { } details)
{
  <MudPaper Outlined="true" Class="pa-4 mb-4">
    <MudText Typo="Typo.h5" HtmlTag="h2">@details.Policy.DisplayName</MudText>
    <MudButton OnClick="EditAsync" Disabled="@(_confirmation is not null || _openingEditor)" Color="Color.Primary" Class="my-3">Edit</MudButton>
    <MudText Class="mt-2">Policy Object ID</MudText>
    <CopyIdentifier Value="details.Policy.ObjectId" Label="Policy Object ID" />
    <MudText Class="mt-3">IsOrganizationDefault: @(details.Policy.IsOrganizationDefault?.ToString() ?? "Not returned")</MudText>
    @if (details.Policy.Definitions.Count == 0)
    {
      <MudText Class="mt-3">No policy definition was returned.</MudText>
    }
    @foreach (var definition in details.Policy.Definitions)
    {
      <MudDivider Class="my-4" />
      <ClaimsMappingDefinitionView Definition="definition" />
    }
  </MudPaper>
  <MudPaper Outlined="true" Class="pa-4">
    <MudText Typo="Typo.h6" HtmlTag="h2">Applies to</MudText>
    <MudButton OnClick="Assign" Disabled="@(_confirmation is not null || _openingEditor || details.Assignments.IsFailure)" Color="Color.Primary" Class="my-3">Assign to Enterprise Application</MudButton>
    @if (details.Assignments.IsSuccess)
    {
      var assignments = details.Assignments.Value;
      <MudText Class="my-3">Enterprise Applications / Service Principals</MudText>
      <MudTable Items="assignments.ServicePrincipals" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent><MudTh>Display Name</MudTh><MudTh>Application / Client ID</MudTh><MudTh>Service Principal Object ID</MudTh><MudTh>Details</MudTh></HeaderContent>
        <RowTemplate>
          <MudTd DataLabel="Display Name">@context.DisplayName</MudTd>
          <MudTd DataLabel="Application / Client ID"><CopyIdentifier Value="context.AppId" Label="Application / Client ID" /></MudTd>
          <MudTd DataLabel="Service Principal Object ID"><CopyIdentifier Value="context.ObjectId" Label="Service Principal Object ID" /></MudTd>
          <MudTd>
            <MudButton OnClick="@(() => OpenServicePrincipal(context.ObjectId))" Disabled="@(_confirmation is not null || _openingEditor)">Open</MudButton>
            <MudButton OnClick="@(() => Unassign(context))" Disabled="@(_confirmation is not null || _openingEditor)">Unassign</MudButton>
          </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>No Service Principals returned for this policy.</MudText></NoRecordsContent>
      </MudTable>
      @if (assignments.Applications.Count > 0)
      {
        <MudText Class="my-3">App Registrations returned by appliesTo</MudText>
        <MudTable Items="assignments.Applications" Dense="true" Breakpoint="Breakpoint.Sm">
          <HeaderContent><MudTh>Display Name</MudTh><MudTh>Application / Client ID</MudTh><MudTh>Application Object ID</MudTh><MudTh>Details</MudTh></HeaderContent>
          <RowTemplate>
            <MudTd DataLabel="Display Name">@context.DisplayName</MudTd>
            <MudTd DataLabel="Application / Client ID"><CopyIdentifier Value="context.AppId" Label="Application / Client ID" /></MudTd>
            <MudTd DataLabel="Application Object ID"><CopyIdentifier Value="context.ObjectId" Label="Application Object ID" /></MudTd>
            <MudTd><MudButton OnClick="@(() => OpenApplication(context.ObjectId))">Open</MudButton></MudTd>
          </RowTemplate>
        </MudTable>
      }
      @foreach (var item in assignments.OtherObjects)
      {
        <MudText Class="mt-3">Directory object with limited or unsupported details: @(item.Type ?? "Type unavailable")</MudText>
        <CopyIdentifier Value="item.ObjectId" Label="Directory Object ID" />
      }
    }
    else
    {
      <MudText>Assignments could not be retrieved. Resolve the error above and refresh.</MudText>
    }
  </MudPaper>
}
@if (_confirmation is { } confirmation)
{
  <ChangeClaimsMappingPolicyAssignment @key="confirmation" Context="confirmation" Policy="_confirmationPolicy"
    Principal="_unassignPrincipal" IsUnassignment="@(_unassignPrincipal is not null)" AssignedPrincipalIds="_assignedPrincipalIds"
    OnCancel="Cancel" OnFinished="FinishedAsync" />
}
