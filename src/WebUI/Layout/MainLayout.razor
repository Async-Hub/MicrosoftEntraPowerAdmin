@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudText Typo="Typo.h6">Microsoft Entra Power Admin</MudText>
        <MudSpacer />
        <UserMenu />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            <AuthorizeView>
                <TenantSelector />
                <MudNavMenu Class="mb-4">
                    <MudNavLink Href="admin" Match="NavLinkMatch.All">Administration</MudNavLink>
                    <MudNavGroup Title="Applications" Expanded="true" Icon="@Icons.Material.Filled.Apps">
                        <MudNavLink Href="applications" Match="NavLinkMatch.Prefix">App Registrations</MudNavLink>
                        <MudNavLink Href="service-principals" Match="NavLinkMatch.Prefix">Enterprise Applications</MudNavLink>
                    </MudNavGroup>
                    <MudNavLink Href="claims-mapping-policies" Match="NavLinkMatch.Prefix">Claims Mapping Policies</MudNavLink>
                </MudNavMenu>
            </AuthorizeView>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
<div id="blazor-error-ui" role="alert">
    An unexpected error occurred. <a href="">Reload MEPA</a>
</div>
